{
	"$schema": "https://json.schemastore.org/claude-code-settings.json",
	"permissions": {
		"allow": [
			"Bash(bun install)",
			"Bash(bun run validate)",
			"Bash(bun run sync)",
			"Bash(bun run build)",
			"Bash(bun run test)",
			"Bash(bun run typecheck)",
			"Bash(bun run lint)",
			"Bash(bun run lint:md)",
			"Bash(bun run lint:md:fix)",
			"Bash(bun run check)",
			"Bash(bun run format)",
			"Bash(bun run lint:links)",
			"Bash(bun run matrix)",
			"Bash(bun run knip)",
			"Bash(bun run registry)",
			"Bash(bun run signals)",
			"Bash(bun run discover:*)",
			"Bash(bun run recommend:*)",
			"Bash(bun run plan:*)",
			"Bash(bun run execute:*)",
			"Bash(bun run evaluate)",
			"Read(**)"
		],
		"deny": ["Write(node_modules/**)", "Write(dist/**)", "Write(.turbo/**)"]
	}
}
