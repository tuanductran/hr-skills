{
	"name": "hr-skills-build",
	"version": "0.0.0",
	"private": true,
	"description": "Build tooling for HR Skills — validates, syncs, and packages HR skill definitions",
	"type": "module",
	"license": "MIT",
	"author": "Tuan Duc Tran",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/tuanductran/hr-skills.git",
		"directory": "packages/hr-skills-build"
	},
	"keywords": [
		"hr",
		"human-resources",
		"skills",
		"ai-skills",
		"claude",
		"llm",
		"agents"
	],
	"scripts": {
		"build": "bun run build-zip && bun run build-skill",
		"build-zip": "bun src/build/build-skills.ts",
		"build-skill": "bun src/build/build-skills.ts --skill",
		"validate": "bun src/validation/validate.ts",
		"sync": "bun src/build/sync.ts",
		"matrix": "bun src/build/generate-skill-matrix.ts",
		"registry": "bun src/cli/generate-registry.ts",
		"discover": "bun src/cli/discover.ts",
		"signals": "bun src/cli/generate-relevance-signals.ts",
		"plan": "bun src/cli/generate-plan.ts",
		"recommend": "bun src/cli/recommend.ts",
		"execute": "bun src/cli/execute-plan.ts",
		"evaluate": "bun src/cli/run-evaluation.ts",
		"test": "bun test",
		"dev": "bun --watch src/validation/validate.ts",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@clack/prompts": "catalog:",
		"valibot": "catalog:",
		"skills-ref": "workspace:*",
		"yaml": "catalog:"
	}
}
