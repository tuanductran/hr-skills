{
	"name": "hr-skills-build",
	"version": "0.1.0",
	"private": true,
	"description": "Build tooling for HR Skills — validates, syncs, and packages HR skill definitions",
	"type": "module",
	"license": "MIT",
	"author": "Tuan Duc Tran",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/tuanductran/hr-skills.git",
		"directory": "packages/hr-skills-build"
	},
	"keywords": [
		"hr",
		"human-resources",
		"skills",
		"ai-skills",
		"claude",
		"llm",
		"agents"
	],
	"main": "./dist/index.mjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"default": "./dist/index.mjs"
		},
		"./client": {
			"types": "./dist/index.client.d.mts",
			"default": "./dist/index.client.mjs"
		},
		"./server": {
			"types": "./dist/server/index.d.mts",
			"default": "./dist/server/index.mjs"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsdown",
		"build-skills": "bun src/build/build-skills.ts",
		"dev": "tsdown --watch",
		"test": "bun test",
		"typecheck": "tsc --noEmit",
		"validate": "bun src/validation/validate.ts",
		"sync": "bun src/build/sync.ts",
		"matrix": "bun src/build/generate-skill-matrix.ts",
		"docs-data": "bun src/build/generate-docs-data.ts"
	},
	"dependencies": {
		"hr-skills-ref": "workspace:*",
		"tsdown": "catalog:",
		"valibot": "catalog:",
		"yaml": "catalog:",
		"@clack/prompts": "catalog:"
	}
}
