{
	"name": "hr-skills",
	"version": "0.0.0",
	"description": "Command-line tools for discovering, validating, planning, evaluating, and executing HR Skills",
	"type": "module",
	"bin": {
		"hr-skills": "./dist/bin/hr-skills.mjs"
	},
	"files": [
		"dist",
		"README.md",
		"registry",
		"skills"
	],
	"publishConfig": {
		"access": "public"
	},
	"engines": {
		"node": ">=20.19.0"
	},
	"license": "MIT",
	"author": "Tuan Duc Tran",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/tuanductran/hr-skills.git",
		"directory": "packages/hr-skills"
	},
	"keywords": [
		"hr",
		"human-resources",
		"skills",
		"ai-skills",
		"agents",
		"cli"
	],
	"scripts": {
		"build": "tsdown",
		"test": "bun test",
		"dev": "tsdown --watch",
		"typecheck": "tsc --noEmit",
		"prepublishOnly": "bun run build",
		"prepack": "bun scripts/prepare-package.ts",
		"postpack": "bun scripts/prepare-package.ts --clean",
		"discover": "bun src/cli/discover.ts",
		"find": "bun src/cli/discover.ts",
		"list": "bun src/cli/list.ts",
		"init": "bun src/cli/init.ts",
		"recommend": "bun src/cli/recommend.ts",
		"plan": "bun src/cli/generate-plan.ts",
		"execute": "bun src/cli/execute-plan.ts",
		"evaluate": "bun src/cli/run-evaluation.ts",
		"skill-review": "bun src/cli/skill-review.ts",
		"registry": "bun src/cli/generate-registry.ts",
		"signals": "bun src/cli/generate-relevance-signals.ts"
	},
	"dependencies": {},
	"devDependencies": {
		"@clack/prompts": "catalog:",
		"hr-skills-build": "workspace:*",
		"hr-skills-ref": "workspace:*",
		"tsdown": "catalog:",
		"typescript": "catalog:"
	}
}
