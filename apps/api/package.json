{
	"$schema": "https://json.schemastore.org/package.json",
	"name": "hr-skills-api",
	"version": "0.0.0",
	"private": true,
	"description": "Hosted HTTP adapter for HR Skills — exposes hr-skills-build/server over Bun + Elysia.",
	"type": "module",
	"license": "MIT",
	"author": "Tuan Duc Tran",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/tuanductran/hr-skills.git",
		"directory": "apps/api"
	},
	"scripts": {
		"build": "bun build src/index.ts --target=bun --outdir=dist",
		"dev": "bun run --watch src/index.ts",
		"start": "bun run src/index.ts",
		"test": "bun test",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"elysia": "1.4.29",
		"hr-skills-build": "workspace:*",
		"hr-skills-ref": "workspace:*"
	}
}
