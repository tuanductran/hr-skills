{
	"$schema": "https://json.schemastore.org/package.json",
	"name": "hr-skills-api",
	"version": "0.0.0",
	"private": true,
	"description": "Hosted HTTP adapter scaffold for HR Skills — exposes hr-skills-build/server over Bun + Elysia.",
	"type": "module",
