{
	"name": "hr-skills-web",
	"version": "0.3.0",
	"private": true,
	"type": "module",
	"description": "HR Skills catalog rebuilt from the caezium site UI with React, TanStack, and Bun.",
	"scripts": {
		"generate:data": "bun scripts/generate-data.ts",
		"dev": "vite --host 0.0.0.0",
		"build": "bun run generate:data && vite build",
		"preview": "vite preview --host 0.0.0.0",
		"typecheck": "tsc --noEmit",
		"lint": "biome lint src e2e scripts uno.config.ts vite.config.ts playwright.config.ts index.html",
		"test": "bun test",
		"test:e2e": "playwright test"
	},
	"dependencies": {
		"@radix-ui/react-dialog": "catalog:frontend",
		"@tanstack/react-query": "^5.87.1",
		"@tanstack/react-router": "^1.139.12",
		"hr-skills-build": "workspace:*",
		"lucide-react": "catalog:frontend",
		"react": "catalog:frontend",
		"react-dom": "catalog:frontend",
		"react-hot-toast": "catalog:frontend",
		"react-markdown": "catalog:frontend",
		"rehype-sanitize": "catalog:frontend",
		"remark-gfm": "catalog:frontend"
	},
		"devDependencies": {
			"@types/bun": "catalog:",
			"@types/node": "catalog:",
			"@types/react": "catalog:frontend",
		"@types/react-dom": "catalog:frontend",
		"@vitejs/plugin-react": "catalog:frontend",
		"@playwright/test": "catalog:testing",
		"typescript": "catalog:",
		"unocss": "catalog:",
		"vite": "catalog:frontend"
	}
}
