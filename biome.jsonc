{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"files": {
		"includes": [
			"./**/*.{ts,tsx}",
			"./**/*.{json,jsonc}",
			"!**/dist",
			"!**/node_modules",
			"!**/.turbo",
			"!**/.claude-plugin",
			"!**/.codex-plugin",
			"!**/.agents/plugins",
			"!**/registry",
			"!**/.next",
			"!**/next-env.d.ts",
			"!apps/web/data/skills.json",
			"!packages/hr-skills/eval-report.json"
		]
	},
	"assist": {
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"formatter": {
		"enabled": true,
		"attributePosition": "multiline",
		"indentStyle": "tab",
		"indentWidth": 4,
		"lineEnding": "lf",
		"lineWidth": 90
	},
	"javascript": {
		"formatter": {
			"enabled": true,
			"arrowParentheses": "always",
			"attributePosition": "multiline",
			"bracketSameLine": true,
			"bracketSpacing": true,
			"jsxQuoteStyle": "single",
			"quoteStyle": "single",
			"semicolons": "always",
			"trailingCommas": "all"
		},
		"globals": ["Bun"]
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"complexity": {
				"useLiteralKeys": "off"
			}
		}
	},
	"overrides": [
		{
			"includes": ["apps/web/app/components/**/*.{ts,tsx}"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"paths": {
									"hr-skills-build/server": "This directory holds client components ('use client'). Import from 'hr-skills-build/client' instead — the server surface uses Node built-ins that break in the browser."
								},
								"patterns": [
									{
										"group": ["node:*", "node:*/**"],
										"message": "This directory holds client components ('use client'). Node built-ins are server-only — move this logic into apps/web/app/lib/ and pass the result in as a prop."
									}
								]
							}
						}
					}
				}
			}
		}
	],
	"vcs": {
		"defaultBranch": "main",
		"clientKind": "git",
		"enabled": true
	}
}
