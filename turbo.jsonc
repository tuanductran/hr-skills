{
	"$schema": "./node_modules/turbo/schema.json",
	"globalDependencies": ["bun.lock", "tsconfig.json", "biome.jsonc"],
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"outputs": ["dist/**", ".next/**", "!.next/cache/**", "!.next/dev/**"]
		},
		"build-skills": {
			"cache": false,
			"dependsOn": ["^build"]
		},
		"dev": {
			"dependsOn": ["^build"],
			"persistent": true,
			"cache": false
		},
		"deploy-commands": {
			"cache": false,
			"dependsOn": ["^build"]
		},
		"typecheck": {
			"dependsOn": ["^build"]
		},
		"test": {
			"dependsOn": ["^build"]
		},
		"test:e2e": {
			"cache": false,
			"dependsOn": ["^build"]
		},
		"validate": {
			"dependsOn": ["^build"]
		},
		"sync": {
			"cache": false,
			"dependsOn": ["^build"]
		},
		"discover": {
			"cache": false,
			"dependsOn": ["^build"]
		},
		"recommend": {
			"cache": false,
			"dependsOn": ["^build"]
		},
		"execute": {
			"cache": false,
			"outputs": ["execution-result.json"],
			"dependsOn": ["^build"]
		},
		"matrix": {
			"cache": false,
			"outputs": ["docs/engineering/skill-matrix.md"],
			"dependsOn": ["^build"]
		},
		"registry": {
			"cache": false,
			"outputs": ["registry/skills.json"],
			"dependsOn": ["^build"]
		},
		"signals": {
			"cache": false,
			"outputs": ["registry/relevance-signals.json"],
			"dependsOn": ["^build", "evaluate"]
		},
		"plan": {
			"cache": false,
			"outputs": ["execution-plan.json"],
			"dependsOn": ["^build"]
		},
		"evaluate": {
			"cache": false,
			"outputs": ["eval-report.json"],
			"dependsOn": ["^build"]
		},
		"docs-data": {
			"cache": false,
			"dependsOn": ["^build"],
			"outputs": ["apps/web/data/skills.json"]
		},
		"api-docs": {
			"cache": false,
			"dependsOn": ["^build"],
			"outputs": ["docs/engineering/api.md"]
		},
		"api-docs:check": {
			"cache": false,
			"dependsOn": ["^build"],
			"outputs": ["docs/engineering/api.md"]
		}
	}
}
