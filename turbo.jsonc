{
	"$schema": "./node_modules/turbo/schema.json",
	"globalDependencies": ["bun.lock"],
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"outputs": ["dist/**", ".next/**"]
		},
		"build-skills": {
			"cache": false
		},
		"dev": {
			// The playground dev servers resolve `hr-skills-build/client` to
			// `dist/index.client.mjs`, which does not exist on a clean clone until
			// tsdown emits it — without this they race the watcher and fail.
			"dependsOn": ["^build"],
			"persistent": true,
			"cache": false
		},
		"typecheck": {
			"dependsOn": ["^build"]
		},
		"test": {
			"dependsOn": ["^build"]
		},
		"validate": {
			"dependsOn": ["^build"]
		},
		"sync": {
			"cache": false,
			"dependsOn": ["^build"]
		},
		"discover": {
			"cache": false,
			"dependsOn": ["^build"]
		},
		"recommend": {
			"cache": false,
			"dependsOn": ["^build"]
		},
		"execute": {
			"cache": false,
			"outputs": ["execution-result.json"],
			"dependsOn": ["^build"]
		},
		"matrix": {
			"cache": false,
			"outputs": ["docs/engineering/skill-matrix.md"],
			"dependsOn": ["^build"]
		},
		"registry": {
			"cache": false,
			"outputs": ["registry/skills.json"],
			"dependsOn": ["^build"]
		},
		"signals": {
			"cache": false,
			"outputs": ["registry/relevance-signals.json"],
			"dependsOn": ["^build", "evaluate"]
		},
		"plan": {
			"cache": false,
			"outputs": ["execution-plan.json"],
			"dependsOn": ["^build"]
		},
		"evaluate": {
			"cache": false,
			"outputs": ["eval-report.json"],
			"dependsOn": ["^build"]
		},
		"docs-data": {
			"cache": false,
			"dependsOn": ["^build"],
			"outputs": ["playground/next-app/data/skills.json"]
		},
		"api-docs": {
			"cache": false,
			"dependsOn": ["^build"],
			"outputs": ["docs/engineering/api.md"]
		},
		"api-docs:check": {
			"cache": false,
			"dependsOn": ["^build"],
			"outputs": ["docs/engineering/api.md"]
		}
	}
}
