{
	"$schema": "./node_modules/turbo/schema.json",
	"globalDependencies": ["bun.lock"],
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"outputs": ["dist/**"]
		},
		"build-skills": {
			"dependsOn": ["^build"],
			"cache": false
		},
		"dev": {
			"persistent": true,
			"cache": false
		},
		"typecheck": {
			"dependsOn": ["^build"]
		},
		"test": {
			"dependsOn": ["^build"]
		},
		"validate": {
			"dependsOn": ["^build"]
		},
		"sync": {
			"cache": false,
			"dependsOn": ["^build"]
		},
		"discover": {
			"cache": false,
			"dependsOn": ["^build"]
		},
		"recommend": {
			"cache": false,
			"dependsOn": ["^build"]
		},
		"execute": {
			"cache": false,
			"outputs": ["execution-result.json"],
			"dependsOn": ["^build"]
		},
		"matrix": {
			"cache": false,
			"outputs": ["docs/skill-matrix.md"],
			"dependsOn": ["^build"]
		},
		"registry": {
			"cache": false,
			"outputs": ["registry/skills.json"],
			"dependsOn": ["^build"]
		},
		"signals": {
			"cache": false,
			"outputs": ["registry/relevance-signals.json"],
			"dependsOn": ["^build", "evaluate"]
		},
		"plan": {
			"cache": false,
			"outputs": ["execution-plan.json"],
			"dependsOn": ["^build"]
		},
		"evaluate": {
			"cache": false,
			"outputs": ["eval-report.json"],
			"dependsOn": ["^build"]
		}
	}
}
