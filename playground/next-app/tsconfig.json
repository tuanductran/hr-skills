{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["dom", "esnext"],
		"jsx": "preserve",
		"module": "esnext",
		"moduleResolution": "bundler",
		"strict": true,
		"skipLibCheck": true,
		"noEmit": true,
		"plugins": [
			{
				"name": "next"
			}
		],
		"allowJs": true,
		"incremental": true,
		"esModuleInterop": true,
		"resolveJsonModule": true,
		"isolatedModules": true
	},
	"include": ["**/*.ts", "**/*.tsx", "**/*.d.ts", ".next/types/**/*.ts"],
	"exclude": ["node_modules"]
}
